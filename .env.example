# --- Supabase (obrigatório) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=chave-anon-publica

# Chave de serviço (Settings > API). Obrigatória apenas para recursos de
# administrador: criar usuários pelo painel, redefinir senhas e operações do bot.
# Nunca expor no navegador (não usa prefixo NEXT_PUBLIC_).
SUPABASE_SERVICE_ROLE_KEY=

# --- Site (obrigatório em produção) ---
NEXT_PUBLIC_SITE_URL=https://seu-app.vercel.app

# --- Opcionais ---
# Nome exibido no site (marca do torneio).
NEXT_PUBLIC_CLUB_NAME=F CHALLENGER

# Telegram (100% opcional - sistema funciona sem ele).
TELEGRAM_BOT_TOKEN=
# Segredo usado no header X-Telegram-Bot-Api-Secret-Token do webhook.
TELEGRAM_WEBHOOK_SECRET=
